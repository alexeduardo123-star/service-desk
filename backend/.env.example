PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://servicedesk_user:senha@localhost:5432/servicedesk"
JWT_SECRET="defina-um-segredo-forte"
JWT_EXPIRES_IN=8h

# Envio de email (recuperação de senha). Se deixado em branco, os emails são
# apenas exibidos no console do backend (modo desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Service Desk <naoresponda@servicedesk.local>"
