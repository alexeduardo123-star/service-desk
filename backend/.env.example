PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://servicedesk_user:servicedesk_pw@localhost:5432/servicedesk"
JWT_SECRET="defina-um-segredo-forte"
JWT_EXPIRES_IN=8h

# Envio de email: código de confirmação de cadastro, código de recuperação de
# senha e notificações. Se deixado em branco, NENHUM email é enviado: os códigos
# aparecem apenas no terminal do backend (modo desenvolvimento).
# Este arquivo (.env) não vai para o Git: cada pessoa precisa preencher o seu.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu email e
# SMTP_PASS=uma "senha de app" (https://myaccount.google.com/apppasswords),
# não a senha normal da conta. Veja a seção "Envio de email" no README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FlowDesk <naoresponda@flowdesk.local>"
