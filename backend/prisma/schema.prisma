generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMIN
  TECNICO
  GESTOR
  SOLICITANTE
}

enum StatusTicket {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_USUARIO
  SUSPENSO
  FECHADO
}

enum TipoNotificacao {
  TICKET_CRIADO
  TICKET_ATRIBUIDO
  TICKET_STATUS
  TICKET_COMENTARIO
  TICKET_APROVACAO
  SISTEMA
}

// Aprovação do gestor do setor. NAO_EXIGIDA: a categoria do chamado não pede
// aprovação (é o caso da maioria e de todos os chamados antigos).
enum StatusAprovacao {
  NAO_EXIGIDA
  PENDENTE
  APROVADA
  REJEITADA
}

model Usuario {
  id             Int           @id @default(autoincrement())
  nome           String
  email          String        @unique
  senhaHash      String
  papel          PapelUsuario  @default(SOLICITANTE)
  ativo          Boolean       @default(true)
  telefone       String?
  cargo          String?
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  createdAt      DateTime      @default(now())

  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  emailVerificado           Boolean   @default(true)
  verificacaoTokenHash      String?
  verificacaoTokenExpiresAt DateTime?

  ticketsSolicitados       Ticket[]             @relation("TicketSolicitante")
  ticketsAtribuidos        Ticket[]             @relation("TicketTecnico")
  ticketsAprovados         Ticket[]             @relation("TicketAprovador")
  assuntosResponsavel      Assunto[]            @relation("AssuntoResponsavel")
  agendamentos             Agendamento[]        @relation("AgendamentoAtendente")
  agendamentosCriados      Agendamento[]        @relation("AgendamentoCriador")
  colaboracoes             TicketColaborador[]  @relation("TicketColaboradorUsuario")
  colaboradoresAdicionados TicketColaborador[]  @relation("TicketColaboradorAdicionadoPor")
  comentarios              Comentario[]
  equipamentos             Equipamento[]
  artigos                  BaseConhecimento[]
  configuracao             ConfiguracaoUsuario?
  notificacoes             Notificacao[]
  relatoriosSalvos         RelatorioSalvo[]

  @@map("usuarios")
}

// Ajustes de permissão por perfil. As permissões e seus valores padrão ficam no
// código (src/utils/permissoes.js); esta tabela guarda só o que o administrador
// liberou ou bloqueou diferente do padrão.
model PerfilPermissao {
  id        Int          @id @default(autoincrement())
  papel     PapelUsuario
  permissao String
  concedida Boolean
  updatedAt DateTime     @updatedAt

  @@unique([papel, permissao])
  @@map("perfil_permissoes")
}

model Departamento {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String?

  usuarios     Usuario[]
  equipamentos Equipamento[]
  tickets      Ticket[]

  @@map("departamentos")
}

model Categoria {
  id             Int     @id @default(autoincrement())
  nome           String
  descricao      String?
  // Chamados desta categoria só andam depois que o gestor do setor aprova.
  exigeAprovacao Boolean @default(false)

  tickets Ticket[]
  artigos BaseConhecimento[]

  @@map("categorias")
}

model Prioridade {
  id       Int    @id @default(autoincrement())
  nome     String
  nivel    Int
  slaHoras Int

  tickets  Ticket[]
  assuntos Assunto[]

  @@map("prioridades")
}

model Equipamento {
  id             Int           @id @default(autoincrement())
  nome           String
  tipo           String
  numeroSerie    String        @unique
  usuarioId      Int?
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id])
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])

  tickets   Ticket[]
  contratos ContratoManutencao[]

  @@map("equipamentos")
}

model Ticket {
  id                  Int             @id @default(autoincrement())
  titulo              String
  descricao           String
  status              StatusTicket    @default(ABERTO)
  solicitanteId       Int
  solicitante         Usuario         @relation("TicketSolicitante", fields: [solicitanteId], references: [id])
  tecnicoId           Int?
  tecnico             Usuario?        @relation("TicketTecnico", fields: [tecnicoId], references: [id])
  categoriaId         Int
  categoria           Categoria       @relation(fields: [categoriaId], references: [id])
  prioridadeId        Int
  prioridade          Prioridade      @relation(fields: [prioridadeId], references: [id])
  equipamentoId       Int?
  equipamento         Equipamento?    @relation(fields: [equipamentoId], references: [id])
  // Setor do chamado (nas telas, "Departamento" aparece como "Setor"). Opcional
  // no banco por causa dos chamados antigos; pela tela é sempre informado.
  departamentoId      Int?
  departamento        Departamento?   @relation(fields: [departamentoId], references: [id])
  // Assunto escolhido ao abrir o chamado (define a prioridade). Opcional por
  // causa dos chamados antigos e dos abertos sem escolher um assunto.
  assuntoId           Int?
  assunto             Assunto?        @relation(fields: [assuntoId], references: [id])
  aprovacaoStatus     StatusAprovacao @default(NAO_EXIGIDA)
  aprovadorId         Int?
  aprovador           Usuario?        @relation("TicketAprovador", fields: [aprovadorId], references: [id])
  aprovacaoEm         DateTime?
  aprovacaoMotivo     String?
  // Respostas do formulário do assunto: [{ campoId, rotulo, tipo, valor }]. O
  // rótulo é copiado para o histórico não mudar se o formulário for editado depois.
  respostasFormulario Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  closedAt            DateTime?

  comentarios   Comentario[]
  notificacoes  Notificacao[]
  agendamentos  Agendamento[]
  colaboradores TicketColaborador[]

  @@map("tickets")
}

// Atendentes que ajudam no chamado sem ser o responsável (tecnicoId). Um
// usuário aparece no máximo uma vez por chamado.
model TicketColaborador {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuarioId       Int
  usuario         Usuario  @relation("TicketColaboradorUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  // Opcional para o registro sobreviver se quem adicionou for excluído.
  adicionadoPorId Int?
  adicionadoPor   Usuario? @relation("TicketColaboradorAdicionadoPor", fields: [adicionadoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([ticketId, usuarioId])
  @@index([usuarioId])
  @@map("ticket_colaboradores")
}

// Atendimento agendado na agenda de um atendente (opcionalmente ligado a um
// chamado). Os prazos de SLA que aparecem na agenda são calculados a partir dos
// chamados, não ficam nesta tabela.
model Agendamento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String?
  inicio      DateTime
  fim         DateTime
  atendenteId Int
  atendente   Usuario  @relation("AgendamentoAtendente", fields: [atendenteId], references: [id], onDelete: Cascade)
  criadoPorId Int?
  criadoPor   Usuario? @relation("AgendamentoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ticketId    Int?
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([atendenteId, inicio])
  @@index([ticketId])
  @@map("agendamentos")
}

model Comentario {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  mensagem  String
  createdAt DateTime @default(now())

  @@map("comentarios")
}

model BaseConhecimento {
  id          Int        @id @default(autoincrement())
  titulo      String
  conteudo    String
  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  autorId     Int
  autor       Usuario    @relation(fields: [autorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("base_conhecimento")
}

model ConfiguracaoUsuario {
  id                  Int      @id @default(autoincrement())
  usuarioId           Int      @unique
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itensPorPagina      Int      @default(10)
  fusoHorario         String   @default("America/Sao_Paulo")
  notificarEmail      Boolean  @default(false)
  notificarNovoTicket Boolean  @default(true)
  notificarAtribuicao Boolean  @default(true)
  notificarStatus     Boolean  @default(true)
  notificarComentario Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("configuracoes_usuario")
}

model Notificacao {
  id        Int             @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao @default(SISTEMA)
  titulo    String
  mensagem  String
  ticketId  Int?
  ticket    Ticket?         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  lida      Boolean         @default(false)
  lidaEm    DateTime?
  createdAt DateTime        @default(now())

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

model RelatorioSalvo {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  filtros   Json
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("relatorios_salvos")
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String   @unique
  contato   String?
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contratos ContratoManutencao[]

  @@map("fornecedores")
}

model ContratoManutencao {
  id            Int         @id @default(autoincrement())
  titulo        String
  fornecedorId  Int
  fornecedor    Fornecedor  @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  equipamentoId Int
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  inicio        DateTime
  fim           DateTime
  valor         Decimal     @db.Decimal(12, 2)
  status        String      @default("ATIVO")
  observacoes   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([fornecedorId])
  @@index([equipamentoId])
  @@map("contratos_manutencao")
}

enum TipoCampoFormulario {
  TEXTO
  TEXTO_LONGO
  NUMERO
  DATA
  SELECAO
  CHECKBOX
}

model Servico {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assuntos Assunto[]

  @@map("servicos")
}

model Assunto {
  id            Int         @id @default(autoincrement())
  nome          String
  descricao     String?
  ativo         Boolean     @default(true)
  servicoId     Int
  servico       Servico     @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  formularioId  Int?
  formulario    Formulario? @relation(fields: [formularioId], references: [id], onDelete: Restrict)
  // Prioridade que os chamados abertos com este assunto recebem. Opcional no
  // banco por causa dos assuntos antigos; o cadastro (API/tela) exige.
  prioridadeId  Int?
  prioridade    Prioridade? @relation(fields: [prioridadeId], references: [id], onDelete: Restrict)
  // Atendente responsável: os chamados deste assunto já nascem atribuídos a ele.
  responsavelId Int?
  responsavel   Usuario?    @relation("AssuntoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tickets Ticket[]

  @@unique([servicoId, nome])
  @@index([formularioId])
  @@index([prioridadeId])
  @@index([responsavelId])
  @@map("assuntos")
}

model Formulario {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campos   FormularioCampo[]
  assuntos Assunto[]

  @@map("formularios")
}

model FormularioCampo {
  id           Int                 @id @default(autoincrement())
  formularioId Int
  formulario   Formulario          @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  rotulo       String
  tipo         TipoCampoFormulario @default(TEXTO)
  obrigatorio  Boolean             @default(false)
  opcoes       String[]            @default([])
  ordem        Int                 @default(0)

  @@index([formularioId])
  @@map("formulario_campos")
}
